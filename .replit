entrypoint = "main.py"
modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["mailutils"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = "python avito_monitor_bot.py"
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8080
externalPort = 80
